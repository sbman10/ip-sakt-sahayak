# IP-SAKTI Sahayak — Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials.

# ---------------------------------------------------------------------------
# Large Language Model (Google Gemini)
# ---------------------------------------------------------------------------
# Primary Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Hugging Face Dense Embedding Configuration (Canonical Provider)
# ---------------------------------------------------------------------------
# Hugging Face User Access Token (read permissions required)
HF_TOKEN=your_huggingface_token_here

# Embedding Model Identifier (Canonical: BAAI/bge-m3, 1024 dimensions)
HF_EMBEDDING_MODEL=BAAI/bge-m3

# Inference Provider routing for Hugging Face InferenceClient ('auto' or 'hf-inference')
HF_INFERENCE_PROVIDER=auto

# HTTP timeout in seconds for Hugging Face inference calls
HF_EMBEDDING_TIMEOUT=60

# Enforce unit L2 normalization on dense embeddings (true/false)
HF_EMBEDDING_NORMALIZE=true

# Strictly prohibit fallback to local SentenceTransformer BGE-M3 (true/false)
# Must remain false in production to prevent mixing vector distributions
LOCAL_BGE_FALLBACK=false

# ---------------------------------------------------------------------------
# Qdrant Cloud Hybrid Vector Database
# ---------------------------------------------------------------------------
# Qdrant Cloud cluster endpoint URL (https://<cluster-id>.<region>.aws.cloud.qdrant.io)
QDRANT_URL=https://your-qdrant-cluster-url.cloud.qdrant.io

# Qdrant API key with read/write permissions
QDRANT_API_KEY=your_qdrant_api_key_here

# Active collection name for hybrid search and testing
# Note: Use ragvyn_hybrid_test for development and integration testing
QDRANT_COLLECTION=ragvyn_hybrid_test

# Enable Qdrant non-destructive shadow retrieval alongside Chroma/BM25 (true/false)
QDRANT_SHADOW_RETRIEVAL=false
# Production shadow collection (Phase 5C: strictly ragvyn_prod_v1)
QDRANT_SHADOW_COLLECTION=ragvyn_prod_v1
QDRANT_SHADOW_SAMPLE_RATE=1.0

# ---------------------------------------------------------------------------
# Retrieval Backend Routing & Safe Fallback (Phase 5B)
# ---------------------------------------------------------------------------
# Active retrieval backend: 'chroma_bm25' (default live) or 'qdrant_hybrid'
RETRIEVAL_BACKEND=chroma_bm25

# Target Qdrant production collection
QDRANT_PRODUCTION_COLLECTION=ragvyn_prod_v1

# Enable safe fallback to ChromaDB+BM25 if Qdrant call fails or times out
QDRANT_FALLBACK_ENABLED=true

# Request timeout in seconds for Qdrant retrieval operations
QDRANT_REQUEST_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Controlled Canary Rollout (Phase 5D)
# ---------------------------------------------------------------------------
# Enable deterministic canary routing of live queries to Qdrant (true/false)
QDRANT_CANARY_ENABLED=false

# Percentage of traffic to route to Qdrant canary (0 to 100)
# Default is 0 (all traffic stays on Chroma/BM25)
QDRANT_TRAFFIC_PERCENT=0

# ---------------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------------
# JWT Secret Key for token signing (use a high-entropy secret in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Google OAuth Credentials (for optional social login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Application Paths & Storage
# ---------------------------------------------------------------------------
CHROMA_DB_DIR=./chroma_db
BM25_INDEX_PATH=./bm25_index.pkl
DATABASE_URL=sqlite:///./ip_sakti.db
