# backend/.env.example
# ---------------------------------------------------------------
# Copy to .env and fill in your GEMINI_API_KEY.
# NEVER commit a real API key to version control.
# ---------------------------------------------------------------

# Google Gemini API Key — obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RAG Pipeline Configuration
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHROMA_PATH=../corpus/chroma
RAG_COLLECTION_NAME=ip_sakti_documents
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Debug mode (optional)
DEBUG=true
